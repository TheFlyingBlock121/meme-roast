# Copy this file to ".env" if you want to change a setting. It is optional:
# the game works with no .env file at all. Never put real secrets in this file.

# Port the server listens on. Hosting sites usually set this for you.
PORT=3000

# Minimum players needed to start. Lower it to 1 while testing alone.
MIN_PLAYERS=3

# Seconds players get to submit an image (10-30) and to vote (10-60).
SUBMISSION_SECONDS=30
VOTING_SECONDS=30
